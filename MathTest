import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.BeforeEach;
import static org.junit.jupiter.api.Assertions.*;

import java.util.List;

public class MathTest {

    @Test
    void testGetMath_PositiveNumbers_ReturnsCorrectResults() {
        // Arrange
        int x = 10;
        int y = 5;
        
        // Act
        List<Integer> result = Math.getMath(x, y);
        
        // Assert
        assertEquals(4, result.size());
        assertEquals(15, result.get(0)); // x + y
        assertEquals(5, result.get(1));  // x - y
        assertEquals(50, result.get(2)); // x * y
        assertEquals(2, result.get(3));  // x / y
    }

    @Test
    void testGetMath_NegativeNumbers_ReturnsCorrectResults() {
        // Arrange
        int x = -10;
        int y = -5;
        
        // Act
        List<Integer> result = Math.getMath(x, y);
        
        // Assert
        assertEquals(4, result.size());
        assertEquals(-15, result.get(0)); // x + y
        assertEquals(-5, result.get(1));  // x - y
        assertEquals(50, result.get(2));  // x * y
        assertEquals(2, result.get(3));   // x / y
    }

    @Test
    void testGetMath_MixedSignNumbers_ReturnsCorrectResults() {
        // Arrange
        int x = 10;
        int y = -5;
        
        // Act
        List<Integer> result = Math.getMath(x, y);
        
        // Assert
        assertEquals(4, result.size());
        assertEquals(5, result.get(0));   // x + y
        assertEquals(15, result.get(1));  // x - y
        assertEquals(-50, result.get(2)); // x * y
        assertEquals(-2, result.get(3));  // x / y
    }

    @Test
    void testGetMath_ZeroDividend_ReturnsZeroDivision() {
        // Arrange
        int x = 0;
        int y = 5;
        
        // Act
        List<Integer> result = Math.getMath(x, y);
        
        // Assert
        assertEquals(4, result.size());
        assertEquals(5, result.get(0));  // x + y
        assertEquals(-5, result.get(1)); // x - y
        assertEquals(0, result.get(2));  // x * y
        assertEquals(0, result.get(3));  // x / y
    }

}
